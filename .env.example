# API Configuration
# Copy this file to .env and fill in your actual values
# The .env file is already gitignored and will not be committed

# API Key (required)
API_KEY=your_api_key_here

# API Base URL (optional, can be overridden)
API_BASE_URL=https://api.agrometeo.example.com

# Request timeout in seconds (optional)
TIMEOUT=30

# Enable debug mode (optional)
DEBUG=False
